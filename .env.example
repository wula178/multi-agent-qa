# LLM 配置（Ollama 原生端点；如需接 OpenAI 兼容服务，改成对应 base_url 并在 agents.py 换回 /v1/chat/completions）
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:latest

# Embedding 后端：ollama（默认，免下载）或 local（sentence-transformers）
EMBED_BACKEND=ollama
# ollama 后端填 Ollama 模型名；local 后端填如 BAAI/bge-m3
EMBED_MODEL=qwen3-embedding:0.6b

# 检索与反思参数
TOP_K=5
MAX_RETRY_ROUNDS=2
